<% if notice %>
  <div class="alert alert-success"><%= notice %></div>
<% end %>

<% content_for :title, "Projects" %>

<h1>Projects</h1>

<div class="row">
  <% @projects.each do |project| %>
    <div class="col-md-4">
      <div class="card mb-3">
        <div class="card-body">
          <h5 class="card-title"><%= project.name %></h5>
          <p class="card-text"><%= link_to "Show this project", project, class: "btn btn-primary" %></p>
        </div>
      </div>
    </div>
  <% end %>
</div>

<p>
  <%= link_to "New project", new_project_path, class: "btn btn-success" %>
</p>
