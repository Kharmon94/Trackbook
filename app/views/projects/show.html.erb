<p style="color: green"><%= notice %></p>

<%= render @project %>

<h2>Tracks</h2>
<%= link_to "New track", new_track_path(track: { project_id: @project.id }) %>
<ul>
  <% @project.tracks.each do |track| %>
    <li><%= link_to track.title.presence || "(untitled)", track %></li>
  <% end %>
</ul>

<div>
  <%= link_to "Edit this project", edit_project_path(@project) %> |
  <%= link_to "Back to projects", projects_path %>

  <%= button_to "Destroy this project", @project, method: :delete %>
</div>
