<% if notice %>
  <div class="alert alert-success"><%= notice %></div>
<% end %>

<% content_for :title, "Tracks" %>

<h1>Tracks</h1>

<div class="row">
  <% @tracks.each do |track| %>
    <div class="col-md-4">
      <div class="card mb-3">
        <div class="card-body">
          <h5 class="card-title"><%= track.title.presence || "Untitled" %></h5>
          <p class="card-text"><%= link_to "Show this track", track, class: "btn btn-primary" %></p>
        </div>
      </div>
    </div>
  <% end %>
</div>

<p>
  <%= link_to "New track", new_track_path, class: "btn btn-success" %>
</p>
