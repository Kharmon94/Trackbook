<%= form_with(model: track, html: {class: "container"}) do |form| %>
  <% if track.errors.any? %>
    <div class="alert alert-danger">
      <h4><%= pluralize(track.errors.count, "error") %> prohibited this track from being saved:</h4>
      <ul>
        <% track.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :project_id, "Project", class: "form-label" %>
    <%= form.collection_select :project_id, current_user.projects, :id, :name, {include_blank: true}, {class: "form-select"} %>
  </div>

  <div class="mb-3">
    <%= form.label :title, class: "form-label" %>
    <%= form.text_field :title, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :track_number, class: "form-label" %>
    <%= form.number_field :track_number, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :main_artist, class: "form-label" %>
    <%= form.text_field :main_artist, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :featured_artists, class: "form-label" %>
    <%= form.textarea :featured_artists, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :producers, class: "form-label" %>
    <%= form.textarea :producers, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :hook_chorus_bridge, class: "form-label" %>
    <%= form.textarea :hook_chorus_bridge, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :verses, class: "form-label" %>
    <%= form.textarea :verses, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :video_concept, class: "form-label" %>
    <%= form.textarea :video_concept, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :videographer, class: "form-label" %>
    <%= form.text_field :videographer, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :director, class: "form-label" %>
    <%= form.text_field :director, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :marketing_plan, class: "form-label" %>
    <%= form.textarea :marketing_plan, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :main_concept, class: "form-label" %>
    <%= form.textarea :main_concept, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :cover_art, class: "form-label" %>
    <%= form.file_field :cover_art, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :sketch, class: "form-label" %>
    <%= form.file_field :sketch, class: "form-control" %>
  </div>

  <div>
    <%= form.submit "Save Track", class: "btn btn-primary" %>
  </div>
<% end %>
