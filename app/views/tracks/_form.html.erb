<%= form_with(model: track) do |form| %>
  <% if track.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(track.errors.count, "error") %> prohibited this track from being saved:</h2>

      <ul>
        <% track.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :project_id, "Project", style: "display: block" %>
    <%= form.collection_select :project_id, current_user.projects, :id, :name, include_blank: true %>
  </div>

  <div>
    <%= form.label :title, style: "display: block" %>
    <%= form.text_field :title %>
  </div>

  <div>
    <%= form.label :track_number, style: "display: block" %>
    <%= form.number_field :track_number %>
  </div>

  <div>
    <%= form.label :main_artist, style: "display: block" %>
    <%= form.text_field :main_artist %>
  </div>

  <div>
    <%= form.label :featured_artists, style: "display: block" %>
    <%= form.textarea :featured_artists %>
  </div>

  <div>
    <%= form.label :producers, style: "display: block" %>
    <%= form.textarea :producers %>
  </div>

  <div>
    <%= form.label :hook_chorus_bridge, style: "display: block" %>
    <%= form.textarea :hook_chorus_bridge %>
  </div>

  <div>
    <%= form.label :verses, style: "display: block" %>
    <%= form.textarea :verses %>
  </div>

  <div>
    <%= form.label :video_concept, style: "display: block" %>
    <%= form.textarea :video_concept %>
  </div>

  <div>
    <%= form.label :videographer, style: "display: block" %>
    <%= form.text_field :videographer %>
  </div>

  <div>
    <%= form.label :director, style: "display: block" %>
    <%= form.text_field :director %>
  </div>

  <div>
    <%= form.label :marketing_plan, style: "display: block" %>
    <%= form.textarea :marketing_plan %>
  </div>

  <div>
    <%= form.label :main_concept, style: "display: block" %>
    <%= form.textarea :main_concept %>
  </div>

  <div>
    <%= form.label :cover_art, style: "display: block" %>
    <%= form.file_field :cover_art %>
  </div>

  <div>
    <%= form.label :sketch, style: "display: block" %>
    <%= form.file_field :sketch %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
