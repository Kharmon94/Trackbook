<% if notice %>
  <div class="alert alert-success"><%= notice %></div>
<% end %>

<%= render @track %>

<div class="btn-group" role="group">
  <%= link_to "Edit this track", edit_track_path(@track), class: "btn btn-secondary" %>
  <%= link_to "Back to tracks", tracks_path, class: "btn btn-outline-secondary" %>
  <%= button_to "Destroy this track", @track, method: :delete, class: "btn btn-danger", data: { confirm: "Are you sure?" } %>
</div>
